    <!-- Monitor Mode Explanation Dialog -->
    <string name="monitor_mode_explain_title">كيف يعمل وضع المراقبة</string>
    <string name="monitor_mode_explain_message">لماذا نحتاج هذا؟\n\n🔒 الوضع اليدوي:\nيجب عليك فتح TouchLock والضغط على \"قفل الآن\" في كل مرة.\n\n✨ وضع المراقبة (ذكية):\nيراقب TouchLock التطبيقات التي تختارها (مثل YouTube أو Netflix).\nبمجرد فتحها، تقفل الشاشة تلقائيًا.\n\nلتفعيل هذه الميزة، يجب عليك السماح بـ \"الوصول إلى الاستخدام\" في الشاشة التالية.</string>
